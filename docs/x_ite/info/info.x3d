<![CDATA[ecmascript:

function initialize ()
{
   eventsProcessed ();
}

function eventsProcessed ()
{
   const
      length      = text .string .length,
      size        = text .fontStyle .size * text .fontStyle .spacing,
      key         = new MFFloat (),
      keyValue    = new MFVec3f (),
      keyVelocity = new MFVec3f ();

   for (let i = 0; i < length; ++ i)
   {
      key .push ((i + 1) / (length + 1));
      keyValue .push (new SFVec3f (0, size * i, 0));
   }

   key .unshift (0);
   key .push (1);

   keyValue .unshift (keyValue [0]);
   keyValue .push (keyValue [keyValue .length - 1]);

   keyVelocity .length = key .length;

   interpolator .key         = key;
   interpolator .keyValue    = keyValue;
   interpolator .keyVelocity = keyVelocity;

   timer .cycleInterval = (text .string .length + 2) * cycleInterval;
}]]>
