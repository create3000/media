        <TimeSensor DEF='_20'
            loop='true'/>
        <Script DEF='PointCloudScript'>
          <field accessType='initializeOnly' type='SFColor' name='color1' value='1 0 0'/>
          <field accessType='initializeOnly' type='SFColor' name='color2' value='0.995372 1 0'/>
          <field accessType='inputOnly' type='SFTime' name='set_time'/>
          <field accessType='initializeOnly' type='SFNode' name='geometry'>
            <PointSet USE='_19'/>
          </field>
<![CDATA[ecmascript:

const
   width = Math .PI * 2,
   depth = Math .PI;

function initialize ()
{
   const colors = geometry .color .color;

   colors .length = 0;

   for (let z = 0; z < depth; z += 0.1)
   {
      const t = z / depth;
      const c = color1 .lerp (color2, t);

      for (let x = 0; x < width; x += 0.1)
      {
         colors .push (c);
      }
   }

   set_time (0, 0);
}

function set_time (value, time)
{
   const points = geometry .coord .point;

   for (let z = 0, i = 0; z < depth; z += 0.1)
   {
      for (let x = 0; x < width; x += 0.1, ++ i)
      {
         const y = Math .sin (x + z + value);
         const p = points [i] ??= new SFVec3f ();

         p .x = x;
         p .y = y;
         p .z = z;
      }
   }
}
]]>
        </Script>
      </Layer>
