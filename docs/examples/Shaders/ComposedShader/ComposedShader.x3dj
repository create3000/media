"ecmascript:",
"",
"function initialize ()",
"{",
"   shape .translations .length = 0;",
"",
"   for (let n = 0; n < numPoints; ++ n)",
"   {",
"      shape .translations .push (new SFVec3f (rand (), rand (), rand ()) .normalize () .multiply (radius));",
"   }",
"}",
"",
"function eventsProcessed ()",
"{",
"   shape .rotations [0] = rotation;",
"}",
"",
"function rand ()",
