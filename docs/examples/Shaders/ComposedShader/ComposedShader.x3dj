"data:x-shader/x-fragment,#version 300 es",
"",
"precision highp float;",
"precision highp int;",
"",
"uniform vec3 color;",
"uniform sampler2D dot;",
"",
"in vec4 texCoord;",
"",
"out vec4 x3d_FragColor;",
"",
"void",
"main ()",
"{",
"   x3d_FragColor = texture (dot, texCoord .xy) * vec4 (color, 1.0);",
"}",
""
