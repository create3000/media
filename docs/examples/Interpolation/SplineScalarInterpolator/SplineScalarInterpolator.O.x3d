<![CDATA[ecmascript:

const VELOCITY_SCALE = 0.5;

function initialize ()
{
  eventsProcessed ();
}

function eventsProcessed ()
{
  const length = xInterpolator .keyValue .length;

  lines .vertexCount .length  = length;
  lines .coord .point .length = length * 2;
  points .point .length       = length;

  for (let i = 0; i < length; ++ i)
  {
    const
      x = xInterpolator .keyValue [i],
      y = yInterpolator .keyValue [i],
      v = y + yInterpolator .keyVelocity [i] * VELOCITY_SCALE;

    lines .vertexCount [i] = 2;

    lines .coord .point [i * 2 + 0] .x = x;
    lines .coord .point [i * 2 + 0] .y = y;
    lines .coord .point [i * 2 + 1] .x = x;
    lines .coord .point [i * 2 + 1] .y = v;

    points .point [i] .x = x;
    points .point [i] .y = v;
  }
}
]]>
