<![CDATA[ecmascript:

function initialize ()
{
  eventsProcessed ();
}

function eventsProcessed ()
{
  const length = xInterpolator .keyValue .length;

  points .point .length = length;

  for (let i = 0; i < length; ++ i)
  {
    points .point [i] .x = xInterpolator .keyValue [i];
    points .point [i] .y = yInterpolator .keyValue [i];
  }
}
]]>
