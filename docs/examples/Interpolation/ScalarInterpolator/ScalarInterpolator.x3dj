                "@type": "SFTime",
                "@name": "doubleClickInterval",
                "@value": 0.3
              },
              {
                "@accessType": "initializeOnly",
                "@type": "SFFloat",
                "@name": "pointSize",
                "@value": 0.5
              },
              {
                "@accessType": "initializeOnly",
                "@type": "SFNode",
                "@name": "xInterpolator",
                "-children": [
