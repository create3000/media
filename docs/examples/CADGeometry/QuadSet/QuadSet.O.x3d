.7 0, 20.5 24.7 0, 20.5 25.7 0, 19.5 25.7 0, 20.8 24.7 0, 21.8 24.7 0, 21.8 25.7 0, 20.8 25.7 0, 22.1 24.7 0, 23.1 24.7 0, 23.1 25.7 0, 22.1 25.7 0, 23.4 24.7 0, 24.4 24.7 0, 24.4 25.7 0, 23.4 25.7 0, 24.7 24.7 0, 25.7 24.7 0, 25.7 25.7 0, 24.7 25.7 0, 26 24.7 0, 27 24.7 0, 27 25.7 0, 26 25.7 0, 27.3 24.7 0, 28.3 24.7 0, 28.3 25.7 0, 27.3 25.7 0, 28.6 24.7 0, 29.6 24.7 0, 29.6 25.7 0, 28.6 25.7 0, 29.9 24.7 0, 30.9 24.7 0, 30.9 25.7 0, 29.9 25.7 0, 31.2 24.7 0, 32.2 24.7 0, 32.2 25.7 0, 31.2 25.7 0, 32.5 24.7 0, 33.5 24.7 0, 33.5 25.7 0, 32.5 25.7 0, 33.8 24.7 0, 34.8 24.7 0, 34.8 25.7 0, 33.8 25.7 0, 35.1 24.7 0, 36.1 24.7 0, 36.1 25.7 0, 35.1 25.7 0, 36.4 24.7 0, 37.4 24.7 0, 37.4 25.7 0, 36.4 25.7 0, 37.7 24.7 0, 38.7 24.7 0, 38.7 25.7 0, 37.7 25.7 0'/>
            </QuadSet>
          </Shape>
        </Transform>
        <Script DEF='QuadsScript'
            directOutput='true'>
          <field accessType='inputOnly' type='SFTime' name='set_time'/>
          <field accessType='inputOutput' type='SFInt32' name='width' value='30'/>
          <field accessType='inputOutput' type='SFInt32' name='height' value='20'/>
          <field accessType='inputOutput' type='SFFloat' name='gap' value='0.3'/>
          <field accessType='inputOutput' type='SFTime' name='duration' value='10'/>
          <field accessType='initializeOnly' type='SFNode' name='geometry'>
            <QuadSet USE='_2'/>
          </field>
<![CDATA[ecmascript:

var squares = [ ];

function initialize ()
{
	build ();
}

function set_width (value, time)
{
	build ();
}

function set_height (value, time)
{
	build ();
}

function set_gap (value, time)
{
	build ();
}

function set_duration (value, time)
{
	build ();
}

function set_time ()
{
	var
		color = geometry .color,
		dt    = 1 / Browser .currentFrameRate;

	for (var i = 0, length = squares .length; i < length; ++ i)
	{
		var
			s = squares [i],
			e = (s .elapsedTime += dt),
			f = e / s .duration;

		if (f > 1)
		{
			s .elapsedTime = 0;
			s .duration    = Math .random () * duration;
		}
		else
		{
			color .color [i] = s .start .lerp (s .end, f);
		}
	}
}

function build ()
{
	var
		coord   = geometry .coord,
		color   = geometry .color,
		colors1 = [randomColor (0), randomColor (1), randomColor (2), randomColor (3)],
		colors2 = [randomColor (0), randomColor (1), randomColor (2), randomColor (3)];

	coord .point .length = 0;
	color .color .length = 0;

	squares .length = 0;

	for (var y = 0; y < height; ++ y)
	{
		for (var x = 0; x < width; ++ x)
		{
			var c = squareColor (colors1, x, y);

			squares .push ({
				start: c,
				end: squareColor (colors2, x, y),
				duration: Math .random () * duration,
				elapsedTime: 0,
			});

			color .color .push (c);

			coord .point .push (new SFVec3f ((1 + gap) * x,     (1 + gap) * y,     0),
			                    new SFVec3f ((1 + gap) * x + 1, (1 + gap) * y,     0),
			                    new SFVec3f ((1 + gap) * x + 1, (1 + gap) * y + 1, 0),
			                    new SFVec3f ((1 + gap) * x,     (1 + gap) * y + 1, 0));
		}
	}
}

function squareColor (colors, x, y)
{
	var
		c = bilinearColor (colors, x, y),
		h = c .getHSV ();

	h [2] *= Math .random ();

	c .setHSV (h [0], h [1], h [2]);

	return c;
}

function bilinearColor (colors, x, y)
{
	x = x / (width - 1);
	y = y / (height - 1);

	var c = new SFColor (
		bilinear (colors [0] .r, colors [1] .r, colors [2] .r, colors [3] .r, x, y),
		bilinear (colors [0] .g, colors [1] .g, colors [2] .g, colors [3] .g, x, y),
		bilinear (colors [0] .b, colors [1] .b, colors [2] .b, colors [3] .b, x, y)
	);

	var
		h = c .getHSV (),
		r = new SFColor ();

	r .setHSV (
		h [0],
		h [1],
		stretch (h [2])
	);

	return  r;
}

function stretch (v)
{
	return Math .sin ((1 - v) * Math .PI + Math .PI / 2) / 2 + 0.5;
}

// dc
// ab
function bilinear (a, b, c, d, x, y)
{
	return a * (1 - x) * (1 - y) + b * x * (1 - y) + d * (1 - x) * y + c * x * y;
}

function randomColor (i)
{
	var c = new SFColor ();

	c .setHSV (
		(i + Math .random ()) * Math .PI / 2,
		1,
		1
	);

	return c;
}
]]>
        </Script>
        <TimeSensor DEF='_26'
            loop='true'/>
      </Layer>
      <Layer DEF='X_ITE'
          pointerEvents='false'>
        <FontLibrary DEF='NanamiBold'
            family='Nanami Bold'
            url='"Nanami-Bld.otf"'/>
        <Transform DEF='Browser'>
          <Shape>
            <Text
                string='"X_ITE"'
                solid='true'>
              <FontStyle
                  family='"Nanami Bold"'
                  size='3.25'
                  justify='"MIDDLE", "MIDDLE"'/>
            </Text>
          </Shape>
        </Transform>
        <Transform DEF='Version'
            translation='-4.29715 -1.85128 0'
            scale='0.2669 0.2669 0.2669'>
          <Shape>
            <Text DEF='_27'
                string='"version 16.1.2"'
                solid='true'>
              <FontStyle
                  family='"Nanami Bold"'
                  size='3.25'
                  justify='"BEGIN", "BEGIN"'/>
            </Text>
          </Shape>
        </Transform>
        <Script DEF='VersionScript'>
          <field accessType='outputOnly' type='MFString' name='version_changed'/>
<![CDATA[ecmascript:

function initialize ()
{
	version_changed [0] = "version " + Browser .version;
}
]]>
        </Script>
      </Layer>
    </LayerSet>
    <ROUTE fromNode='_26' fromField='time' toNode='QuadsScript' toField='set_time'/>
    <ROUTE fromNode='VersionScript' fromField='version_changed' toNode='_27' toField='set_string'/>
    <ROUTE fromNode='AnimationTimer' fromField='fraction_changed' toNode='QuadSetTranslationInterpolator' toField='set_fraction'/>
    <ROUTE fromNode='QuadSetTranslationInterpolator' fromField='value_changed' toNode='QuadSet' toField='set_translation'/>
  </Scene>
</X3D>
